Dataset my_first_dataset {
  label: 'My First Dataset'
  description: ''
  data_source_name: 'holistics'
  models: [
    public_activation_codes,
    public_activities
  ]
  relationships: [
    relationship(public_activities.id > public_activation_codes.code, true)
    ,
    relationship(public_activation_codes.expired_at > public_activities.id, true)
  ]
  owner: 'thang1@gmail1.com'
}